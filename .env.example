# Copy this to .env for local testing (and never commit the real .env).
# On Render, set these as Environment Variables in the dashboard instead.

DISCORD_TOKEN=your_bot_token_here
COMMAND_PREFIX=!

# Your Discord user ID (right-click your name in Discord with Developer Mode on)
CREATOR_ID=0

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Upstash Redis — REST URL + token from your Upstash dashboard
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
